         <string notr="true">QSpinBox {
   background-color: rgba(209, 142, 34, 60);
   border-radius: 6px;
   
   border: 2px solid line;
   border-color: rgb(214, 136, 41);
   padding-right: 10px; /* make room for the arrows */
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right; /* position at the top right corner */
    width: 28px; 
    border-width: 1px;
}


QSpinBox::down-button {
   subcontrol-origin: border;
    subcontrol-position: bottom right; /* position at bottom right corner */

    width: 26px;

    border-width: 1px;
}

QSpinBox::up-button:hover {

}

QSpinBox::up-button:pressed {
   
}

QSpinBox::down-arrow {
    image: url(D:/PICTURES/ImagesToPrograms/arrow_down.png);

    width: 30px;
    height: 60px;
}

QSpinBox::up-arrow {
    image: url(D:/PICTURES/ImagesToPrograms/arrow_up.png);
    width: 30px;
    height: 60px;
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off { /* off state when value is max */
   image: url(:/images/up_arrow_disabled.png);
}



QSpinBox::down-button:hover {
    border-image: url(:/images/spindown_hover.png) 1;
}

QSpinBox::down-button:pressed {
    border-image: url(:/images/spindown_pressed.png) 1;
}


